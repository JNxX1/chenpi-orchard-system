# 复制为 .env 后按需修改；.env 不要提交到仓库
SECRET_KEY=请改成随机长字符串

# 数据库与文件存储（默认 instance/orchard.db 与 storage/）
# DATABASE_URL=sqlite:///D:/毕业设计/instance/orchard.db
# STORAGE_DIR=D:/毕业设计/storage
MAX_IMAGE_SIZE_MB=15

# 登录：首次启动且没有任何用户时，用下面的账号密码创建初始管理员
AUTH_ENABLED=1
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
SESSION_HOURS=8

# YOLO 模型：陈皮柑专用权重路径、置信度阈值、IoU、设备（空=自动，cpu，0=第一块GPU）
MODEL_PATH=models/chenpigan_best.pt
MODEL_CONF=0.25
MODEL_IOU=0.45
MODEL_DEVICE=
# 模型说明（加载模型后显示在页面提示条，说明来源与适用边界）
MODEL_NOTE=
# 无模型时是否允许 OpenCV 颜色阈值演示模式（结果会标注为演示）
ALLOW_DEMO_DETECTOR=1

# 智能助手：默认接本机 Ollama；也可以切到任意 OpenAI 兼容接口
LLM_ENABLED=1
LLM_PROVIDER=ollama
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen3:8b
LLM_TIMEOUT=120
# 用云端 OpenAI 兼容接口时（示例：DeepSeek）：
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat
# LLM_API_KEY=你的密钥（不要提交到仓库）
